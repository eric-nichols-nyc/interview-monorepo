{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite"],
  "javascript": {
    "globals": ["Liveblocks"]
  },
  "linter": {
    "rules": {
      "nursery": {
        "noDeprecatedImports": "error",
        "noShadow": "off" // Allow shadowing parameters
      },
      "style": {
        "noMagicNumbers": "off"
      },
      "suspicious": {
        "noEmptyBlockStatements": "off", // Allow empty blocks (e.g., empty callbacks)
        "noExplicitAny": "warn", // Allow any but warn about it
        "noAlert": "off", // Allow alert/confirm (useful for quick debugging)
        "useAwait": "off", // Allow async functions without await
        "noArrayIndexKey": "warn" // Allow array index as key but warn
      },
      "correctness": {
        "noUnusedVariables": "warn" // Downgrade unused vars to warning
      },
      "complexity": {
        "noForEach": "off", // Allow forEach (common pattern)
        "noExcessiveCognitiveComplexity": "off" // Allow complex functions
      },
      "performance": {
        "noAccumulatingSpread": "warn" // Downgrade performance issues to warnings
      },
      "a11y": {
        "noLabelWithoutControl": "warn" // Downgrade accessibility to warning
      }
    }
  },
  "files": {
    "includes": [
      "**/*",
      "!packages/design-system/components/ui",
      "!packages/design-system/lib",
      "!packages/design-system/hooks",
      "!packages/collaboration/config.ts",
      "!docs/components/ui",
      "!docs/lib",
      "!docs/hooks",
      "!apps/docs/**/*.json",
      "!apps/email/.react-email",
      "!packages/cms/basehub-types.d.ts",
      "!packages/design-system/components/ai-elements"
    ]
  }
}
